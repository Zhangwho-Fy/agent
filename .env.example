# 复制成 .env 再填值；.env 已被 .gitignore 忽略，不会进仓库
#
# API key 从本机 Codex 配置里取（~/.codex/config.toml 里 deepseek 提供方的那个 sk-...），
# 手动复制过来即可。绝不要把 key 写进任何会被提交的文件。

AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-v4-flash
AGENT_BASE_URL=https://api.deepseek.com
AGENT_API_KEY=

AGENT_WORKSPACE=.
AGENT_MAX_TOOL_ROUNDS=12
AGENT_TOOL_TIMEOUT_S=60
AGENT_OUTPUT_LIMIT_BYTES=8192
AGENT_APPROVAL_TIMEOUT_S=120

# 上下文压缩（docs/context-engineering.md 第 5 节）
# 60% 起做指针化（零 LLM 调用），80% 起才动摘要；评测回放建议把 ENABLED 设成 false
AGENT_COMPRESS_ENABLED=true
AGENT_COMPRESS_LOSSLESS_RATIO=0.6
AGENT_COMPRESS_SUMMARY_RATIO=0.8
AGENT_COMPRESS_KEEP_RECENT_TOOL_RESULTS=4

AGENT_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_LOG_LEVEL=info
